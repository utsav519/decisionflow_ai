cat > .gitignore <<'EOF'
# Environment and secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build and runtime
dist/
build/
*.log
logs/
tmp/
.cache/

# Database
*.db
*.sqlite
*.sqlite3

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker overrides
docker-compose.override.yml
EOF